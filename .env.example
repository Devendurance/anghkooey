# Server-only. Never use NEXT_PUBLIC_ for these. No credentials below.

# Chat model
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Official current model: deepseek-flash.
DEEPSEEK_MODEL=deepseek-flash
# Routine answers + extraction run non-thinking (saves output tokens).
# Set "enabled" only if a future feature needs reasoning traces.
# DEEPSEEK_THINKING=disabled

# App + SQL (Neon PostgreSQL connection string, SSL required)
DATABASE_URL=
WEB_BASE_URL=http://localhost:3000
# Required in production (worker refuses to boot without it). 32+ random chars.
APP_SESSION_SECRET=

# Walrus Memory Mainnet (production account at https://memory.walrus.xyz)
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Photon Spectrum (Slice 3)
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
TELEGRAM_BOT_TOKEN=

# Qloo cultural dining (TasteProof). Server-only: never expose via NEXT_PUBLIC_*.
# Required for /taste and the chat dining flow; the adapter fails honestly without it.
QLOO_API_KEY=
# Optional. Defaults to the Qloo hackathon endpoint when unset.
QLOO_BASE_URL=https://hackathon.api.qloo.com

NODE_ENV=development

# User-owned Gmail (Slice Gmail-A, all server-side, never NEXT_PUBLIC_)
# Google Cloud OAuth client (Desktop/Web application) + Gmail send scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 64 hex chars (32 bytes). Encrypts Gmail tokens at rest. Generate once:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GMAIL_TOKEN_KEY=
