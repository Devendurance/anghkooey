    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "spectrum-ts": "^12.10.1",
    "zod": "^4.6.5"
