    "worker:start": "tsx workers/photon-worker.ts",
    "photon:readiness": "tsx scripts/photon-readiness.ts",
    "channel:evidence": "tsx scripts/channel-evidence.ts",
    "diagnose:hotel": "tsx scripts/diagnose-hotel-url.ts",
    "identity:diagnose": "tsx scripts/identity-diagnose.ts",
    "test:qa": "tsx scripts/qa-preflight.ts && vitest run",
    "qa:approve": "tsx scripts/qa-preflight.ts --approve",
    "test:e2e": "LD_LIBRARY_PATH=$HOME/.playwright-deps/libs/usr/lib/x86_64-linux-gnu playwright test",
